# Apify (https://console.apify.com/account/integrations)
APIFY_API_TOKEN=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google Sheets — path to a service account JSON key.
# 1. Create a service account in Google Cloud Console, enable the Sheets API.
# 2. Download its JSON key and save it e.g. as ./service_account.json
# 3. Share your target Google Sheet with the service account's email
#    (found inside the JSON as "client_email") with Editor access.
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json

# Only needed if config.yaml has scraper_mode: "authenticated"
# 1. Install a cookie-export extension (e.g. Cookie-Editor) in your browser.
# 2. Log into linkedin.com normally.
# 3. Export/copy the LinkedIn cookies as JSON, save to a file, e.g. ./linkedin_cookies.json
# 4. Set your browser's user agent string below (search "my user agent").
LINKEDIN_COOKIES_FILE=./linkedin_cookies.json
LINKEDIN_USER_AGENT=
